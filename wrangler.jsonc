{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cementarii",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cementarii.net",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b7cf504275f3422bbfeb96008f6620d6",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c64e9be266b9467ba728116f2dc95fa5",
    },
  ],
}
