{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cementarii",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cementarii.net", "custom_domain": true }],

  "observability": {
    "enabled": true,
  },
}
